[Unit]
Description=Minici Store (Streamlit)
After=network.target

[Service]
Type=simple
User=minici
WorkingDirectory=/home/minici/minici-store
Environment="MINICI_DISCO_PERSISTENTE=1"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/minici/minici-store/.venv/bin/streamlit run app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
